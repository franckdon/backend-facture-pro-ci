generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// MASTER — tables globales (inchangées)
// ============================================================

model societe {
  id                     Int       @id @default(autoincrement())
  uuid                   String    @unique @default(uuid()) @db.Char(36)
  code_societe           String?   @unique @db.VarChar(100)
  raison_sociale_societe String?   @db.VarChar(150)
  ncc                    String?   @db.VarChar(50)
  rccm                   String?   @db.VarChar(50)
  regime_imposition      String?   @db.VarChar(45)
  centre_impot           String?   @db.VarChar(100)
  ref_bancaire           String?   @db.VarChar(100)
  adresse                String?   @db.VarChar(200)
  telephone              String?   @db.VarChar(14)
  email                  String?   @db.VarChar(100)
  cree_le                DateTime? @default(now())
  modifie_le             DateTime? @updatedAt

  bd_host  String? @db.VarChar(100)
  bd_name  String? @db.VarChar(100)
  bd_user  String? @db.VarChar(100)
  bd_pass  String? @db.VarChar(255)
  bd_port  Int?
  logo_url String? @db.VarChar(100)

  statut_id Int?
  statut    statut? @relation(fields: [statut_id], references: [id])

  configuration      configuration?
  etablissement      etablissement[]
  utilisateur_client utilisateur_client[]
  licences           licence[]
  stickers           sticker[]

  // Relations vers les tables tenant
  entete_facture             entete_facture[]
  tiers                      tiers[]
  information_complementaire information_complementaire[]
  produit                    produit[]
  type_produit               type_produit[]
}

model etablissement {
  id                    Int      @id @default(autoincrement())
  uuid                  String   @unique @default(uuid()) @db.Char(36)
  societe_id            Int
  code_etablissement    String   @db.VarChar(50)
  libelle_etablissement String   @db.VarChar(150)
  cree_le               DateTime @default(now())
  modifie_le            DateTime @updatedAt

  societe     societe       @relation(fields: [societe_id], references: [id], onDelete: Cascade)
  point_vente point_vente[]

  @@unique([societe_id, code_etablissement])
}

model point_vente {
  id               Int           @id @default(autoincrement())
  uuid             String        @unique @default(uuid()) @db.Char(36)
  etablissement_id Int
  libelle_pdv      String        @db.VarChar(150)
  cree_le          DateTime      @default(now())
  etablissement    etablissement @relation(fields: [etablissement_id], references: [id], onDelete: Cascade)
}

model licence {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid()) @db.Char(36)
  societe_id      Int
  plan_id         Int?
  cle             String    @unique @db.VarChar(255)
  date_expiration DateTime?
  statut_id       Int?

  societe societe  @relation(fields: [societe_id], references: [id], onDelete: Cascade)
  plan    plan?    @relation(fields: [plan_id], references: [id])
  statut  statut?  @relation(fields: [statut_id], references: [id])
}

model utilisateur_client {
  id                      BigInt    @id @default(autoincrement())
  uuid                    String    @unique @default(uuid()) @db.Char(36)
  email                   String    @db.VarChar(150)
  login                   String    @db.VarChar(150)
  mot_de_passe            String    @db.VarChar(255)
  nom_complet             String    @db.VarChar(150)
  statut_id               Int       @default(1)
  societe_id              Int?
  role_id                 BigInt?
  cree_le                 DateTime  @default(now())
  dernier_login           DateTime?
  otp_secret              String?   @db.VarChar(255)
  otp_expiration          DateTime?
  tokenVersion            Int       @default(1)
  verification_token      String?   @db.VarChar(255)
  verification_expiration DateTime?

  role    role?    @relation(fields: [role_id], references: [id])
  societe societe? @relation(fields: [societe_id], references: [id], onDelete: Cascade)
  statut  statut   @relation(fields: [statut_id], references: [id])
}

model mode_paiement {
  id                    BigInt @id @default(autoincrement())
  uuid                  String @unique @default(uuid()) @db.Char(36)
  code_mode_paiement    String @unique @db.VarChar(50)
  libelle_mode_paiement String @db.VarChar(100)
}

model taux_imposition {
  id          BigInt @id @default(autoincrement())
  uuid        String @unique @default(uuid()) @db.Char(36)
  code        String @unique @db.VarChar(50) 
  pourcentage Float
  description String @db.VarChar(200)
}

model type_facture {
  id                   BigInt @id @default(autoincrement())
  uuid                 String @unique @default(uuid()) @db.Char(36)
  code_type_facture    String @unique @db.VarChar(50)
  libelle_type_facture String @db.VarChar(50)
}

model devise {
  id          BigInt @id @default(autoincrement())
  uuid        String @unique @default(uuid()) @db.Char(36)
  code_devise String @unique @db.VarChar(50)
  taux_devise String @db.VarChar(50)
  description String @db.VarChar(150)
}

model type_facturation {
  id                       BigInt @id @default(autoincrement())
  uuid                     String @unique @default(uuid()) @db.Char(36)
  code_type_facturaction   String @unique @db.VarChar(50)
  libelle_type_facturation String @db.VarChar(50)
}

model sticker {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid()) @db.Char(36)
  societe_id      Int       @unique
  balance_sticker Int?
  date_maj        DateTime? @updatedAt
  societe         societe   @relation(fields: [societe_id], references: [id], onDelete: Cascade)
}

model configuration {
  id             Int     @id @default(autoincrement())
  uuid           String  @unique @default(uuid()) @db.Char(36)
  societe_id     Int     @unique
  cle_api_fne    String? @db.VarChar(255)
  cle_api_locale String? @db.VarChar(255)
  production     Int     @default(0) @db.TinyInt

  societe societe @relation(fields: [societe_id], references: [id], onDelete: Cascade)
}

model statut {
  id                 Int                  @id @default(autoincrement())
  uuid               String               @unique @default(uuid()) @db.Char(36)
  code               String               @unique @db.VarChar(50)
  description        String?              @db.VarChar(255)
  societes           societe[]
  licences           licence[]
  utilisateur_client utilisateur_client[]
}

model role {
  id                 BigInt               @id @default(autoincrement())
  uuid               String               @unique @default(uuid()) @db.Char(36)
  code               String               @unique @db.VarChar(50)
  description        String?              @db.VarChar(255)
  utilisateur_client utilisateur_client[]
}

model utilisateur_admin {
  id                      BigInt    @id @default(autoincrement())
  uuid                    String    @unique @default(uuid()) @db.Char(36)
  email                   String    @db.VarChar(150)
  login                   String    @db.VarChar(150)
  mot_de_passe            String    @db.VarChar(255)
  nom_complet             String    @db.VarChar(150)
  cree_le                 DateTime  @default(now())
  dernier_login           DateTime?
  otp_secret              String?   @db.VarChar(255)
  otp_expiration          DateTime?
  tokenVersion            Int       @default(1)
  verification_token      String?   @db.VarChar(255)
  verification_expiration DateTime?
}

model plan {
  id                  Int       @id @default(autoincrement())
  uuid                String    @unique @default(uuid()) @db.Char(36)
  libelle             String    @db.VarChar(100)
  code                String    @unique @db.VarChar(50)
  prix_annuel         Decimal   @db.Decimal(19, 4)
  limite_utilisateurs Int       @default(1)
  description         String?   @db.VarChar(255)
  licences            licence[]
}

model faq {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.Char(36)
  question   String   @db.Text
  reponse    String   @db.Text
  ordre      Int      @default(0)
  est_actif  Boolean  @default(true)
  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt
}

// ============================================================
// TENANT — données métier isolées par societe_id
// ============================================================

model entete_facture {
  id             BigInt   @id @default(autoincrement())
  uuid           String   @unique @default(uuid()) @db.Char(36)
  societe_id     Int      // 🔑 isolation par société
  numero_facture String   @db.VarChar(100)
  date_facture   DateTime @db.Date

  code_type_facture     String @db.VarChar(50)
  code_type_facturation String @db.VarChar(50)
  code_mode_paiement    String @db.VarChar(50)
  code_devise           String @db.VarChar(50)

  total_ht         Decimal @db.Decimal(19, 4)
  total_tva        Decimal @db.Decimal(19, 4)
  total_remise     Decimal @db.Decimal(19, 4)
  total_autre_taxe Decimal @db.Decimal(19, 4)
  total_ttc        Decimal @db.Decimal(19, 4)

  point_vente   String @db.VarChar(150)
  etablissement String @db.VarChar(150)

  certifie               Int     @default(0) @db.TinyInt
  retour_ncc             String? @db.VarChar(200)
  retour_id_facture      String? @db.VarChar(200)
  retour_token           String? @db.VarChar(200)
  retour_reference       String? @db.VarChar(200)
  numero_facture_origine String? @db.VarChar(200)

  id_tiers                      BigInt
  id_information_complementaire BigInt?

  societe                    societe                     @relation(fields: [societe_id], references: [id], onDelete: Cascade)
  tiers                      tiers                       @relation(fields: [id_tiers], references: [id])
  information_complementaire information_complementaire? @relation(fields: [id_information_complementaire], references: [id])
  detail_facture             detail_facture[]
  taxe_pieds                 taxe_pieds[]

  @@index([societe_id])
}

model detail_facture {
  id                        BigInt   @id @default(autoincrement())
  uuid                      String   @unique @default(uuid()) @db.Char(36)
  id_entete_facture         BigInt
  code_taux_imposition      String   @db.VarChar(50)
  reference_article         String?  @db.VarChar(100)
  designation_article       String?  @db.VarChar(250)
  quantite                  Float
  unite_vente               String   @db.VarChar(50)
  prix                      Decimal  @db.Decimal(19, 4)
  montant_ht                Decimal  @db.Decimal(19, 4)
  remise                    Float
  montant_ttc               Decimal  @db.Decimal(19, 4)
  montant_taux_imposition   Decimal  @db.Decimal(19, 4)
  retour_detail             String   @db.VarChar(150)
  ligne_avoir               Int      @db.TinyInt
  id_detail_origine_facture BigInt
  montant_remise            Decimal  @db.Decimal(19, 4)

  entete_facture entete_facture @relation(fields: [id_entete_facture], references: [id], onDelete: Cascade)
  taxe_details   taxe_details[]
}

model taxe_details {
  id                   BigInt         @id @default(autoincrement())
  id_detail_facture    BigInt
  libelle_taxe_details String?        @db.VarChar(50)
  taux_taxe_details    Float
  montant_taxe_details Decimal        @db.Decimal(19, 4)
  detail_facture       detail_facture @relation(fields: [id_detail_facture], references: [id], onDelete: Cascade)
}

model taxe_pieds {
  id                 BigInt         @id @default(autoincrement())
  id_entete_facture  BigInt
  libelle_taxe_pieds String?        @db.VarChar(50)
  taux_taxe_pieds    Float
  montant_taxe_pieds Decimal        @db.Decimal(19, 4)
  entete_facture     entete_facture @relation(fields: [id_entete_facture], references: [id], onDelete: Cascade)
}

model tiers {
  id                   BigInt           @id @default(autoincrement())
  uuid                 String           @unique @default(uuid()) @db.Char(36)
  societe_id           Int              // 🔑 isolation par société
  code_tiers           String           @db.VarChar(150)
  raison_sociale_tiers String           @db.VarChar(150)
  ncc_tiers            String           @db.VarChar(150)
  telephone_tiers      String?          @db.VarChar(150)
  email_tiers          String?          @db.VarChar(150)

  societe        societe          @relation(fields: [societe_id], references: [id], onDelete: Cascade)
  entete_facture entete_facture[]

  @@unique([societe_id, code_tiers]) // était @unique global, maintenant unique PAR société
  @@index([societe_id])
}

model information_complementaire {
  id                 BigInt  @id @default(autoincrement())
  uuid               String  @unique @default(uuid()) @db.Char(36)
  societe_id         Int     // 🔑 isolation par société
  pied_de_page       String? @db.VarChar(255)
  nom_commercial     String? @db.VarChar(150)
  autre_mention      String? @db.Text
  plus_d_information String? @db.Text

  societe        societe          @relation(fields: [societe_id], references: [id], onDelete: Cascade)
  entete_facture entete_facture[]

  @@index([societe_id])
}

model type_produit {
  id         BigInt    @id @default(autoincrement())
  uuid       String    @unique @default(uuid()) @db.Char(36)
  societe_id Int       // 🔑 isolation par société
  code       String    @db.VarChar(50)
  libelle    String    @db.VarChar(100)

  societe  societe   @relation(fields: [societe_id], references: [id], onDelete: Cascade)
  produits produit[]

  @@unique([societe_id, code]) // était @unique global, maintenant unique PAR société
  @@index([societe_id])
}

model produit {
  id              BigInt       @id @default(autoincrement())
  uuid            String       @unique @default(uuid()) @db.Char(36)
  societe_id      Int          // 🔑 isolation par société
  reference       String       @db.VarChar(150)
  designation     String       @db.VarChar(150)
  prix_base       Decimal      @db.Decimal(19, 4) @default(0.0000)
  description     String?      @db.VarChar(255)
  type_produit_id BigInt
  type_produit    type_produit @relation(fields: [type_produit_id], references: [id])
  cree_le         DateTime     @default(now())
  modifie_le      DateTime     @updatedAt

  societe societe @relation(fields: [societe_id], references: [id], onDelete: Cascade)

  @@index([societe_id])
}